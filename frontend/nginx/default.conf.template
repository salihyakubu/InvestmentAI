# Rendered at container start by the nginx image's envsubst step
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/). Only ${BACKEND_URL}
# is substituted; nginx's own $host/$uri/etc. are left untouched because they
# are not present in the environment. This file is included in the http context,
# so the map directive below is valid here.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    # ${PORT} is substituted at container start (defaults to 80 via the image's
    # ENV; Railway injects its own PORT and routes public traffic to it).
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Don't cache the entry document so new deploys are picked up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Hashed build assets are immutable.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # REST + WebSocket. proxy_pass without a path preserves the full /api/... URI.
    # The Upgrade headers are inert for plain HTTP and enable the /api/v1/ws/*
    # WebSocket upgrade.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        # Needed when BACKEND_URL is an https upstream (e.g. the Railway public
        # api domain): send SNI so the upstream's TLS handshake succeeds. Inert
        # for plain-http upstreams like docker-compose's http://api:8000.
        proxy_ssl_server_name on;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # The upstream's own host, not the UI's: Railway's public edge routes by
        # Host header, so forwarding the UI domain would 404 at the edge.
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # SPA fallback: any non-file route returns index.html for client routing.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
